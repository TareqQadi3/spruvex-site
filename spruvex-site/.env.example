# انسخ هذا الملف إلى .env.local (لا يُرفع لـ git أبدًا) وعبّئ القيم الحقيقية.

# كلمة مرور لوحة الإدارة (/admin) — استخدم قيمة عشوائية طويلة، لا تشاركها بالكود.
ADMIN_PASSWORD=

# مفتاح تشفير جلسة الإدارة (JWT) — نص عشوائي 32 حرفًا فأكثر.
# يمكن توليده بسرعة عبر: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- تكامل spruvex-r (تفعيل التجربة المجانية الفعلي) ---

# رابط API الأساسي لمشروع spruvex-r (بدون /api/v1 — يُضاف تلقائيًا بالكود).
# مثال إنتاج: https://api.spruvex-r.com — محليًا: http://localhost:3000
SPRUVEX_R_API_URL=

# نفس القيمة المضبوطة حرفيًا كمتغير SPRUVEX_SITE_API_KEY بجانب spruvex-r —
# يُرسل بترويسة x-spruvex-site-key عند استدعاء POST /public/trial-signup هناك.
# ⚠️ يجب أن تُضبط القيمتان يدويًا لتطابقا حرفيًا بكلا المشروعين — لا آلية
# مزامنة تلقائية بينهما. يمكن توليد قيمة جديدة عبر: openssl rand -hex 32
SPRUVEX_SITE_API_KEY=

# --- بريد Resend (بريد ترحيب + تنبيه إدارة عند كل تسجيل جديد) ---
# ⚠️ بريد "رمز التحقق" نفسه لا يُرسل من هذا المشروع — يُرسله spruvex-r
# مباشرة (ResendOtpSender هناك، مفعّل تلقائيًا فقط عندما تكون RESEND_API_KEY
# مضبوطة على خدمة spruvex-r نفسها). اضبط نفس المتغير هناك أيضًا لتفعيل إرسال
# رمز OTP فعليًا بالبريد — بدونه سيبقى الرمز يُطبع بسجلات spruvex-r فقط
# (DevOtpSender)، ولن يصل المستخدم أبدًا في بيئة إنتاج حقيقية.

# مفتاح Resend API — من https://resend.com/api-keys
RESEND_API_KEY=

# عنوان "من" لبريد الترحيب/تنبيه الإدارة — يجب أن يكون على نطاق مُتحقَّق منه
# فعليًا بحساب Resend (مثال: "SpruVex R <noreply@spruvex.example>")، وإلا
# سيرفض Resend الإرسال.
RESEND_FROM_EMAIL=

# البريد الذي يصل إليه تنبيه "تسجيل تجربة مجانية جديد" عند كل محاولة.
ADMIN_ALERT_EMAIL=

# --- تخزين البيانات (اختياري) ---

# مسار مجلد بيانات SQLite/الإيصالات. اختياري محليًا (افتراضيًا data/ بجذر
# المشروع). على Render يُضبط تلقائيًا عبر render.yaml ليطابق mountPath
# الخاص بالـ Persistent Disk — لا تحتاج لضبطه يدويًا هناك.
# DATA_DIR=
